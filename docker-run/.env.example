# Copy to .env to override defaults. This file alone is not loaded by Compose.
JULIA_IMAGE=julia:1.11.9-bookworm
GEMS_THREADS=8
GEMS_CPUS=8
GEMS_MEMORY=10g
GEMS_CONFIG=/opt/GEMS/data/DefaultConf.toml
# Empty population: generate a synthetic population using the TOML configuration.
# For a local file, use a container path such as /input/people.csv.
GEMS_POPULATION=
GEMS_SETTINGS=
# Empty values preserve the settings in the selected TOML file.
GEMS_POP_SIZE=
GEMS_TICKS=
GEMS_SEED=42
GEMS_CSV=true
GEMS_REPORT=false
# Empty: LightRD without a report; DefaultResultData when a report is requested.
GEMS_RD_STYLE=
